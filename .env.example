# Render > Environment. NAO enviar valores reais para o GitHub.
PORT=10000
NODE_ENV=production
FIREBASE_DATABASE_URL=https://appqua-22-default-rtdb.firebaseio.com
# Cole o JSON inteiro da service account no Render. OU use Secret File com GOOGLE_APPLICATION_CREDENTIALS
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_WEB_API_KEY=
ADEGA_SESSION_SECRET=
ADEGA_TRACKING_SECRET=
# URL publica do SITE quando criado (para links de rastreamento)
ADEGA_PUBLIC_URL=https://adega24.onrender.com
# Origens HTTPS permitidas para loja/ADM; separadas por virgula; sem / final
ADEGA_CORS_ORIGINS=https://adega24.onrender.com
# Mercado Pago (se ainda nao usar Pix, endpoints retornam 503)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Opcional - para chamada segura do cron
ADEGA_CRON_SECRET=
